{
  "name": "lead-sheets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:data": "node scripts/check-library.mjs",
    "check:music": "node --experimental-strip-types scripts/check-music.ts",
    "check:scroll": "node --experimental-strip-types scripts/check-scroll.ts",
    "check:teach": "node --experimental-strip-types scripts/check-teach.ts",
    "check:teach-screen": "node --experimental-strip-types scripts/check-teach-screen.ts",
    "check:bpm": "node --experimental-strip-types scripts/check-bpm.ts",
    "check:learn": "node --experimental-strip-types scripts/check-learn.ts",
    "check:learned": "node --experimental-strip-types scripts/check-learned.ts",
    "check:storage": "node --experimental-strip-types scripts/check-storage.ts",
    "check:fit": "node --experimental-strip-types scripts/check-fit.ts",
    "check:chords": "node --experimental-strip-types scripts/check-chords.ts",
    "check:headers": "node --experimental-strip-types scripts/check-headers.ts",
    "check:screens": "node --experimental-strip-types scripts/check-screens.ts",
    "check:search": "node --experimental-strip-types scripts/check-search.ts",
    "check:metronome": "node --experimental-strip-types scripts/check-metronome.ts",
    "check:bar": "node --experimental-strip-types scripts/check-bar.ts",
    "check:heard": "node --experimental-strip-types scripts/check-heard.ts",
    "check:api": "tsc -p worker && node --experimental-strip-types scripts/check-api.ts",
    "check:portable": "node --experimental-strip-types scripts/check-portable.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.162.0"
  }
}
