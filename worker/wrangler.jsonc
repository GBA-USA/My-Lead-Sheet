{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mls-rooms",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "DIRECTORY",
        "class_name": "Directory"
      },
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Directory",
        "Room"
      ]
    }
  ]
}
